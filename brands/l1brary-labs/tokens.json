{
  "_comment": "L1brary Labs public website CSS, final cascade observed 2026-10-29. Portable open-font substitutions and production defaults are documented in sources.md.",
  "version": "1",
  "design": {
    "allowedColors": [
      "#ffffff",
      "#101116",
      "#626776",
      "#e3e7ee",
      "#0757f7",
      "#0b111e",
      "#f6faff",
      "#b5d2ff",
      "#b8c7de"
    ],
    "allowedFontTokens": [
      "--brand-font-display",
      "--brand-font-text",
      "--brand-font-mono",
      "Fraunces",
      "Inter",
      "Fragment Mono"
    ],
    "fontStacks": {
      "display": [
        "Fraunces",
        "serif"
      ],
      "text": [
        "Inter",
        "sans-serif"
      ],
      "mono": [
        "Fragment Mono",
        "monospace"
      ]
    },
    "maxRectRadiusPx": 0,
    "tokens": {
      "--brand-color-paper": "#ffffff",
      "--brand-color-ink": "#101116",
      "--brand-color-muted": "#626776",
      "--brand-color-line": "#e3e7ee",
      "--brand-color-signal": "#0757f7",
      "--brand-color-navy": "#0b111e",
      "--brand-color-mist": "#f6faff",
      "--brand-color-blue-pale": "#b5d2ff",
      "--brand-color-slate": "#b8c7de",
      "--brand-radius-sm": "0px",
      "--brand-radius-md": "0px",
      "--brand-radius-lg": "0px",
      "--brand-space-unit": "8px",
      "--brand-stroke": "2px",
      "--brand-weight-display": "400",
      "--brand-weight-text": "400",
      "--brand-weight-strong": "600",
      "--brand-tracking-display": "-0.02em"
    },
    "creativeTypography": {
      "allowedAllCapsTerms": [
        "AI",
        "API",
        "R&D",
        "PDF",
        "PNG",
        "SVG",
        "HTML",
        "UI",
        "UX",
        "CLI",
        "MP4"
      ],
      "canonicalCasing": {
        "L1BRARY LABS": "L1brary Labs",
        "PROOFRAIL": "ProofRail",
        "GRIDOS": "GridOS",
        "CADENCE": "Cadence"
      }
    },
    "roles": {
      "light": {
        "ground": "--brand-color-paper",
        "ink": "--brand-color-ink",
        "accent": "--brand-color-signal",
        "muted": "--brand-color-muted",
        "quiet": "--brand-color-line",
        "rule": "--brand-color-line",
        "series": [
          "--brand-color-signal",
          "--brand-color-navy"
        ]
      },
      "dark": {
        "ground": "--brand-color-navy",
        "ink": "--brand-color-paper",
        "accent": "--brand-color-blue-pale",
        "muted": "--brand-color-slate",
        "quiet": "--brand-color-muted",
        "rule": "--brand-color-muted",
        "series": [
          "--brand-color-blue-pale",
          "--brand-color-paper"
        ]
      }
    },
    "rules": [
      "White editorial surfaces, blue calls to action, dark navy flagship panels.",
      "Serif headlines and plain sans-serif body copy. Open substitutes are documented.",
      "Source all product claims; distinguish research, prototype, pilot and production."
    ]
  },
  "copy": {
    "casingRules": {
      "headlines": "sentence",
      "canonical": {
        "l1brary labs": "L1brary Labs",
        "cadence": "Cadence",
        "proofrail": "ProofRail",
        "gridos": "GridOS",
        "nullmark": "Nullmark"
      }
    },
    "rules": [
      "Preserve supplied copy exactly.",
      "Do not imply clients, commercial partnerships or production readiness from event participation."
    ]
  }
}
